FROM python:3.10-slim

WORKDIR /app

# Feast server with S3 (registry/offline) support.
# protobuf<6 because feast 0.63's feature server calls MessageToDict(float_precision=...),
# which protobuf 7 removed (TypeError on /get-online-features otherwise).
RUN pip install --no-cache-dir "feast[postgres,aws]" boto3 s3fs "protobuf<6"

COPY feature_repo/ ./feature_repo/

# Run the server profile (S3 registry/offline + sqlite online store).
RUN cp feature_repo/feature_store.yaml.server feature_repo/feature_store.yaml

# Dir for the sqlite online store (the server materializes into it).
RUN mkdir -p /app/data

EXPOSE 6000

# Online feature server (REST). Reads registry from S3 and online store from
# Postgres; both are populated by the prepare-data / online-infer stages.
CMD ["feast", "-c", "feature_repo", "serve", "-h", "0.0.0.0", "-p", "6000"]
