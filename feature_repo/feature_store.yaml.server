# Server profile: registry + offline data on S3/Garage, online store on Postgres.
# Activated by copying this over feature_store.yaml when S3 env vars are present
# (see src/feast_utils.configure_feast). Values use Feast ${ENV} interpolation,
# so the SAME file works locally (MinIO/garage) and on the university cluster.
# project: mlpipeline
project: diabetes_risk_prediction
provider: local

# S3 registry: shared across all CI jobs and containers so apply in prepare-data
# is visible to materialize in online-infer. Feast uses boto3 internally, which
# picks up AWS_ENDPOINT_URL automatically (MinIO locally / Garage on cluster).
registry:
  path: s3://feast/registry/registry.db
  registry_ttl_sec: 30

offline_store:
  type: file

# Local online store (sqlite). Postgres is disabled for local runs; to use the
# cluster Postgres online store, uncomment the block below and set the
# POSTGRES_FEAST_* variables.
online_store:
  type: sqlite
  path: data/online_store.db

# online_store:
#   type: postgres
#   host: ${POSTGRES_FEAST_HOST}
#   port: ${POSTGRES_FEAST_PORT}
#   database: ${POSTGRES_FEAST_DB}
#   db_schema: public
#   user: ${POSTGRES_FEAST_USER}
#   password: ${POSTGRES_FEAST_PASSWORD}

entity_key_serialization_version: 3
