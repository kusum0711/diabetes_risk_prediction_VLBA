          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 12,
              "y": 16,
              "width": 12,
              "height": 8,
              "element": {
                "kind": "ElementReference",
                "name": "panel-5"
              }
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
